PORT=8080
DATABASE_URL=postgres://prospect:prospect@localhost:5434/prospect?sslmode=disable
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Simulated gateway: failure rate for exercising error paths. Not a pacing knob.
GATEWAY_FAIL_RATE=0
# Optional: enables real search results via the official Google Places API.
# Leave unset to use the free OpenStreetMap provider instead.
GOOGLE_PLACES_API_KEY=
JWT_SECRET=dev-secret-change-me-in-production
UPLOADS_DIR=./uploads
# Gmail SMTP (an "app password", not your normal Gmail password — generate
# one at myaccount.google.com/apppasswords, requires 2-Step Verification on).
# Leave both empty to keep using the simulated gateway.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
